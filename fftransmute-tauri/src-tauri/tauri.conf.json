{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ffTransmute",
  "version": "0.1.0",
  "identifier": "com.fftransmute.app",
  "build": {
    "frontendDist": "../../mtapi-project/app/static",
    "devUrl": "http://127.0.0.1:24590",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "ffTransmute",
        "url": "loader.html",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
